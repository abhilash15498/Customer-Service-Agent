# Application
APP_ENV=development
APP_PORT=8000
DEBUG=True
SECRET_KEY=change-this-in-production

# LLM & AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customer_service_db

# Cache & Message Broker (Redis / Celery)
REDIS_URL=redis://localhost:6379/0

# Vector Database (ChromaDB / Qdrant / Pinecone / pgvector)
VECTOR_DB_URL=http://localhost:8000
CHROMA_PERSIST_DIRECTORY=./knowledge_base/chroma

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
